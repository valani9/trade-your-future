# Database. Leave unset to use the bundled in-process Postgres for local dev and tests.
DATABASE_URL=
# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Solana devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
ESCROW_SECRET=
MINT_ADDRESS=
WALLET_ENC_KEY=
DEMO_MODE=true
SOLANA_MOCK=true
# Background tick (in-process by default; set CRON_SELF_TICK=off to call /api/cron/tick yourself)
CRON_SECRET=
CRON_SELF_TICK=on
