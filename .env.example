# Database. Leave unset to use the bundled in-process Postgres for local dev and tests.
DATABASE_URL=
# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Solana devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
ESCROW_SECRET=
MINT_ADDRESS=
WALLET_ENC_KEY=
DEMO_MODE=true
SOLANA_MOCK=true
# Background tick (in-process by default; set CRON_SELF_TICK=off to call /api/cron/tick yourself)
CRON_SECRET=
CRON_SELF_TICK=on
# Gemini Prediction Markets (public market data, no key needed)
GEMINI_PM_BASE=https://api.gemini.com
SEED_LIVE_GAMES=on
# ElevenLabs voice (text-to-speech + speech-to-text). Unset = browser voice fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# QuickNode Streams webhook security token (Solana devnet stream -> /api/streams/quicknode)
QUICKNODE_STREAM_TOKEN=
